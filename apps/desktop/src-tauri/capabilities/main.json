{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege grant for the main window: only the app command set, events, window basics and file dialogs (SPEC §4.1).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:app:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "allow-env-list",
    "allow-conn-list",
    "allow-conn-save",
    "allow-conn-delete",
    "allow-conn-test",
    "allow-conn-connect",
    "allow-conn-disconnect",
    "allow-conn-connected",
    "allow-schema-objects",
    "allow-table-columns",
    "allow-table-count",
    "allow-table-browse",
    "allow-session-open",
    "allow-session-close",
    "allow-query-execute",
    "allow-query-cancel",
    "allow-history-search",
    "allow-workspace-get",
    "allow-workspace-set"
  ]
}
